{
  "name": "@mongez/vite",
  "version": "2.1.2",
  "description": "Drop-in Vite plugin for SPA workflows: typed env loading with NODE_ENV-aware resolution, in-HTML env interpolation, tsconfig path aliasing, auto-open dev server, post-build zip, .htaccess generation, and pre-render integration.",
  "main": "src/index.ts",
  "sideEffects": false,
  "author": "hassanzohdy",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanzohdy/mongez-vite"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mongez/copper": "^1.0.1",
    "@mongez/dotenv": "^1.1.8",
    "@mongez/events": "^2.0.0",
    "@mongez/fs": "^3.0.3",
    "@mongez/reinforcements": "^2.3.1",
    "archiver": "^5.3.1"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "dotenv",
    "tsconfig",
    "tsconfig-path",
    "tsconfig-path-resolver",
    "vite-tsconfig-path-resolver",
    "dotenv-in-html",
    "spa",
    "single-page-application",
    "htaccess",
    "prerender",
    "auto-open-browser",
    "build-compress",
    "zip-build",
    "PUBLIC_URL",
    "production-base-url",
    "env-in-html"
  ]
}
